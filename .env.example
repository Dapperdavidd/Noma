DATABASE_URL=postgres://noma:noma@localhost:5432/noma
API_BIND=127.0.0.1:8080
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
RUST_LOG=info
# Authentication attempts allowed per IP in a 15-minute window.
RATE_LIMIT_AUTH_MAX=30

# Optional: signed direct image uploads. Keep secrets on the API server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed preset: allow the image/video formats and limits documented in README.
CLOUDINARY_UPLOAD_PRESET=

# Optional: Sign in with Google. The API safely publishes this public ID to the web app.
GOOGLE_CLIENT_ID=

# Optional: verification and password-recovery email through Resend.
# RESEND_API_KEY is server-only. Never put it in a VITE_* variable.
RESEND_API_KEY=
EMAIL_FROM=NOMA <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:5173
