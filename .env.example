DATABASE_URL=postgres://noma:noma@localhost:5432/noma
API_BIND=127.0.0.1:8080
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
RUST_LOG=info

# Optional: signed direct image uploads. Keep secrets on the API server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed preset: jpg/jpeg/png/webp/avif only, max 10 MB, image resource type.
CLOUDINARY_UPLOAD_PRESET=

# Optional: Sign in with Google. The client ID is public and is shared by the API and web app.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional: verification and password-recovery email through Resend.
# RESEND_API_KEY is server-only. Never put it in a VITE_* variable.
RESEND_API_KEY=
EMAIL_FROM=NOMA <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:5173
