{
  "name": "noma",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "playwright test",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" tests playwright.config.ts",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" tests playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9"
  }
}
